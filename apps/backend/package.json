{
  "name": "@squeez/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:raw": "tsx watch src/index.ts",
    "start:raw": "tsx src/index.ts",
    "dev": "node ../../tools/with-env.mjs testnet tsx watch src/index.ts",
    "dev:mainnet": "node ../../tools/with-env.mjs robinhood mainnet tsx watch src/index.ts",
    "start:testnet": "node ../../tools/with-env.mjs testnet tsx src/index.ts",
    "start:mainnet": "node ../../tools/with-env.mjs robinhood mainnet tsx src/index.ts",
    "start:hyperevm:mainnet": "node ../../tools/with-env.mjs hyperevm mainnet tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@squeez/shared": "*",
    "pg": "^8.13.1",
    "sharp": "0.35.5",
    "viem": "2.21.19"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
