# Copy to .env.mainnet (gitignored).
SQUEEZ_NETWORK=mainnet

# Elysium mainnet: required, from the official docs
ELYSIUM_CHAIN_ID=99901
ELYSIUM_RPC=https://rpc-live.elysp.com

# Deployed contracts on mainnet
FACTORY_ADDRESS=
FACTORY_START_BLOCK=0
FEE_VAULT_ADDRESS=

# Supabase Postgres (Project settings > Database > Connection string, direct or session pooler on port 5432).
# Leave empty to use local PGlite. Ponder creates and owns the tables inside DATABASE_SCHEMA.
DATABASE_URL=
DATABASE_SCHEMA=mainnet
