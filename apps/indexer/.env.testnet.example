# Copy to .env.testnet (gitignored).
SQUEEZ_NETWORK=testnet

# Elysium testnet
ELYSIUM_CHAIN_ID=99801
ELYSIUM_RPC=https://testnet-rpc.elysium.kinetiq.xyz

# Deployed contracts on testnet
FACTORY_ADDRESS=
FACTORY_START_BLOCK=0
FEE_VAULT_ADDRESS=

# Supabase Postgres (Project settings > Database > Connection string, direct or session pooler on port 5432).
# Leave empty to use local PGlite. Ponder creates and owns the tables inside DATABASE_SCHEMA.
DATABASE_URL=
DATABASE_SCHEMA=testnet
