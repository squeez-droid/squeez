# Copy to .env.mainnet (gitignored).
SQUEEZ_NETWORK=mainnet

# Elysium mainnet: required, from the official docs
ELYSIUM_CHAIN_ID=99901
ELYSIUM_RPC=https://rpc-live.elysp.com

# Keeper wallet. Never commit a real key: keep it in .env.mainnet (gitignored) or a secret manager.
KEEPER_PRIVATE_KEY=

# Deployed contracts on mainnet
FEE_VAULT_ADDRESS=
SQUEEZ_TOKEN_ADDRESS=

# TWAP settings (brief: interval and chunk size are TBD)
TWAP_INTERVAL_SECONDS=300
TWAP_CHUNK_HYPE=1
