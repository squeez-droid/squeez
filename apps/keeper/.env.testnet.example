# Copy to .env.testnet (gitignored).
SQUEEZ_NETWORK=testnet

# Elysium testnet
ELYSIUM_CHAIN_ID=99801
ELYSIUM_RPC=https://testnet-rpc.elysium.kinetiq.xyz

# Keeper wallet. Never commit a real key: keep it in .env.testnet (gitignored) or a secret manager.
KEEPER_PRIVATE_KEY=

# Deployed contracts on testnet
FEE_VAULT_ADDRESS=
SQUEEZ_TOKEN_ADDRESS=

# TWAP settings (brief: interval and chunk size are TBD)
TWAP_INTERVAL_SECONDS=300
TWAP_CHUNK_HYPE=1
