{
  "name": "@squeez/keeper",
  "version": "0.1.0",
  "private": true,
  "description": "Off-chain buyback keeper: TWAP-buys $SQUEEZ with the protocol share from SqueezFeeVault and burns it.",
  "type": "module",
  "scripts": {
    "dev": "node ../../tools/with-env.mjs testnet tsx watch src/index.ts",
    "start:testnet": "node ../../tools/with-env.mjs testnet tsx src/index.ts",
    "start:mainnet": "node ../../tools/with-env.mjs mainnet tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@squeez/shared": "*",
    "viem": "^2.21.19"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
