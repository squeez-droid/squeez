# Copy to .env.mainnet (gitignored). Every NEXT_PUBLIC_ value is baked into the static build.
NEXT_PUBLIC_SQUEEZ_NETWORK=mainnet

# Elysium mainnet: required, take both from the official docs (https://elysium.kinetiq.xyz/docs)
NEXT_PUBLIC_ELYSIUM_CHAIN_ID=99901
NEXT_PUBLIC_ELYSIUM_RPC=https://rpc-live.elysp.com
NEXT_PUBLIC_ELYSIUM_EXPLORER=https://elysium.kinetiq.xyz/explorer

# Supabase: read-only access to the "mainnet" schema. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_SCHEMA=mainnet

# Deployed protocol contracts. Never use placeholder addresses.
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_QUOTE_REGISTRY_ADDRESS=
NEXT_PUBLIC_FEE_VAULT_ADDRESS=
