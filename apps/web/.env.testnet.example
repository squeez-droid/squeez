# Copy to .env.testnet (gitignored). Every NEXT_PUBLIC_ value is baked into the static build.
NEXT_PUBLIC_SQUEEZ_NETWORK=testnet

# Required: verified Elysium testnet values from the official documentation.
NEXT_PUBLIC_ELYSIUM_CHAIN_ID=99801
NEXT_PUBLIC_ELYSIUM_RPC=https://testnet-rpc.elysium.kinetiq.xyz
NEXT_PUBLIC_ELYSIUM_EXPLORER=https://explorer-elysium-testnet.t.conduit.xyz

# Supabase: read-only access to the "testnet" schema. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_SCHEMA=testnet

# Deployed protocol contracts. Never use placeholder addresses.
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_QUOTE_REGISTRY_ADDRESS=
NEXT_PUBLIC_FEE_VAULT_ADDRESS=
