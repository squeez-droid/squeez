{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squeez-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "env": {
    "mainnet": {
      "name": "squeez-web-mainnet"
    }
  }
}
