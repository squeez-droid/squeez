{
  "name": "@squeez/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../tools/with-env.mjs testnet next dev",
    "dev:mainnet": "node ../../tools/with-env.mjs mainnet next dev",
    "build": "next build",
    "build:testnet": "node ../../tools/with-env.mjs testnet next build",
    "build:mainnet": "node ../../tools/with-env.mjs mainnet next build",
    "build:worker:testnet": "node ../../tools/with-env.mjs testnet opennextjs-cloudflare build",
    "build:worker:mainnet": "node ../../tools/with-env.mjs mainnet opennextjs-cloudflare build",
    "preview:worker": "node ../../tools/with-env.mjs testnet opennextjs-cloudflare preview",
    "deploy:worker:testnet": "node ../../tools/with-env.mjs testnet opennextjs-cloudflare deploy",
    "deploy:worker:mainnet": "node ../../tools/with-env.mjs mainnet opennextjs-cloudflare deploy --env mainnet",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .open-next out"
  },
  "dependencies": {
    "@squeez/shared": "*",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "lightweight-charts": "^4.2.1",
    "next": "^15.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "2.21.19",
    "wagmi": "2.12.17"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
