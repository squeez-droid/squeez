# Copy to .env.testnet. One root file configures every testnet service.
SQUEEZ_NETWORK=testnet
SQUEEZ_CHAIN=elysium
X_OAUTH_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
SQUEEZ_ATTESTER_PRIVATE_KEY=
SQUEEZ_ATTESTER_ADDRESS=
X_MAX_ATTESTED_LAUNCHES_PER_24H=3
NEXT_PUBLIC_SQUEEZ_NETWORK=testnet
NEXT_PUBLIC_SQUEEZ_CHAIN=elysium
NEXT_PUBLIC_API_URL=https://api-testnet.your-domain.com
PORT=8080
ALLOWED_ORIGINS=https://testnet.your-domain.com
ELYSIUM_CHAIN_ID=99801
ELYSIUM_RPC=https://testnet-rpc.elysium.kinetiq.xyz
ELYSIUM_EXPLORER=https://explorer-elysium-testnet.t.conduit.xyz
# Robinhood stays disabled in the UI until its verified deployment address book exists.
ROBINHOOD_CHAIN_ID=46630
ROBINHOOD_RPC=https://robinhood-sepolia-rpc.publicnode.com
ROBINHOOD_RPC_FALLBACK=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_EXPLORER=https://explorer.testnet.chain.robinhood.com
ROBINHOOD_DATABASE_SCHEMA=robinhood_testnet
# Testnet-only convenience: intentionally reuse the configured Elysium deploy/admin/treasury wallets.
ROBINHOOD_REUSE_ELYSIUM_WALLETS=true
ROBINHOOD_DEPLOYER_PRIVATE_KEY=
ROBINHOOD_UPGRADE_ADMIN_PRIVATE_KEY=
ROBINHOOD_ADMIN_MULTISIG=
ROBINHOOD_TREASURY=
# Filled from deployments/robinhood/testnet*.json after the pinned v4/Squeez deployment.
ROBINHOOD_POOL_MANAGER=
ROBINHOOD_POSITION_MANAGER=
ROBINHOOD_PERMIT2=
ROBINHOOD_UNIVERSAL_ROUTER=
ROBINHOOD_WRAPPED_NATIVE_ADDRESS=
ROBINHOOD_POSITION_DESCRIPTOR_ADDRESS=
ROBINHOOD_V4_STATE_VIEW_ADDRESS=
ROBINHOOD_V4_QUOTER_ADDRESS=
ROBINHOOD_TICKER_LOCK_SECONDS=300
ROBINHOOD_GRADUATION_THRESHOLD_HYPE=100000000000000000
ROBINHOOD_SNIPER_TAX_START_BPS=9900
ROBINHOOD_SNIPER_TAX_DECAY_SECONDS=5
ROBINHOOD_MAX_BUY_BPS_PER_TRANSACTION=100
ROBINHOOD_MAX_WALLET_BPS=500
ROBINHOOD_MAX_WALLET_WINDOW_SECONDS=300
ROBINHOOD_LAUNCH_FEE_HYPE=1000000000000000
PINATA_JWT=
PINATA_API_URL=https://api.pinata.cloud
PINATA_UPLOAD_URL=https://uploads.pinata.cloud/v3/files
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
# Shared PostgreSQL instance. Every deployment target must use its own schema.
DATABASE_URL=
DATABASE_POOL_MAX=2
INDEXER_DATABASE_POOL_MAX=5
INDEXER_MAX_REQUESTS_PER_SECOND=1
# PublicNode Robinhood testnet accepts at most 50,000 blocks per eth_getLogs request.
INDEXER_LOG_BLOCK_RANGE=50000
# Contract addresses below are auto-loaded from packages/contracts/deployments/testnet.json.
# Keep them empty unless an emergency runtime override is required.
DATABASE_SCHEMA=testnet
FACTORY_ADDRESS=
FACTORY_START_BLOCK=
QUOTE_REGISTRY_ADDRESS=
FEE_VAULT_ADDRESS=
PROTECTION_POLICY_REGISTRY_ADDRESS=
PROTECTION_POLICY_REGISTRY_IMPLEMENTATION_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
IDENTITY_REGISTRY_IMPLEMENTATION_ADDRESS=
FACTORY_IMPLEMENTATION_ADDRESS=
QUOTE_REGISTRY_IMPLEMENTATION_ADDRESS=
FEE_VAULT_IMPLEMENTATION_ADDRESS=
CURVE_BEACON_ADDRESS=
CURVE_IMPLEMENTATION_ADDRESS=
GRADUATION_ADAPTER_ADDRESS=
SQUEEZ_TOKEN_ADDRESS=
KEEPER_PRIVATE_KEY=
TWAP_INTERVAL_SECONDS=
TWAP_CHUNK_HYPE=
DEPLOYER_PRIVATE_KEY=
UPGRADE_ADMIN_PRIVATE_KEY=
ADMIN_MULTISIG=
TREASURY=
POOL_MANAGER=
POSITION_MANAGER=
PERMIT2=
UNIVERSAL_ROUTER=
WRAPPED_NATIVE_ADDRESS=
POSITION_DESCRIPTOR_ADDRESS=
V4_STATE_VIEW_ADDRESS=
V4_QUOTER_ADDRESS=
LIQUIDITY_LOCKER_ADDRESS=
SQUEEZ_HOOK_ADDRESS=
SWAP_ROUTER_ADDRESS=
SWAP_ROUTER_START_BLOCK=
V4_LP_FEE_BPS=0
V4_TICK_SPACING=60
ROBINHOOD_V4_LP_FEE_BPS=0
ROBINHOOD_V4_TICK_SPACING=60
GRADUATION_THRESHOLD_HYPE=
# Post-HYPE expansion. Leave blank until each address, route, oracle and policy is approved.
USDC_ADDRESS=
UNIT_ASSET_ADDRESS=
ONDO_ASSET_ADDRESS=
QUOTE_ORACLE_ADDRESS=
QUOTE_ORACLE_MAX_AGE_SECONDS=
SQUEEZ_POOL_ADDRESS=
BUYBACK_PROTOCOL_CUT_BPS=
HOLDER_REWARD_EPOCH_SECONDS=

# Derived automatically: VIRTUAL_HYPE_RESERVE = 40% threshold; VIRTUAL_TOKEN_RESERVE = 1B tokens.
VIRTUAL_HYPE_RESERVE=
VIRTUAL_TOKEN_RESERVE=
SNIPER_TAX_START_BPS=
SNIPER_TAX_DECAY_SECONDS=
MAX_WALLET_BPS=
MAX_WALLET_WINDOW_SECONDS=
LAUNCH_FEE_HYPE=
