# Copy to .env.mainnet (gitignored).
# Elysium mainnet: required, from the official docs
ELYSIUM_RPC=https://rpc-live.elysp.com

# No private key here on mainnet. Sign with an encrypted keystore or hardware wallet:
#   cast wallet import squeez-deployer --interactive
#   npm run deploy:mainnet -w @squeez/contracts -- --account squeez-deployer

ADMIN_MULTISIG=
TREASURY=
# From the Elysium docs
POOL_MANAGER=

# Approved launch configuration, in wei / basis points / seconds. No defaults are applied.
GRADUATION_THRESHOLD_HYPE=
VIRTUAL_HYPE_RESERVE=
VIRTUAL_TOKEN_RESERVE=
SNIPER_TAX_START_BPS=
SNIPER_TAX_DECAY_SECONDS=
MAX_WALLET_BPS=
MAX_WALLET_WINDOW_SECONDS=
LAUNCH_FEE_HYPE=
