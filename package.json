{
  "name": "squeez",
  "version": "0.1.0",
  "private": true,
  "description": "Squeez: fixed-supply token launchpad on Elysium. Monorepo (npm workspaces).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:web:testnet",
    "dev:web:testnet": "npm run dev -w @squeez/web",
    "dev:web:mainnet": "npm run dev:mainnet -w @squeez/web",
    "dev:api:testnet": "npm run dev -w @squeez/backend",
    "dev:api:mainnet": "npm run dev:mainnet -w @squeez/backend",
    "dev:indexer:testnet": "npm run dev -w @squeez/indexer",
    "dev:indexer:mainnet": "npm run dev:mainnet -w @squeez/indexer",
    "dev:keeper:testnet": "npm run dev -w @squeez/keeper",
    "start:keeper:mainnet": "npm run start:mainnet -w @squeez/keeper",
    "build:web:testnet": "npm run build:testnet -w @squeez/web",
    "build:web:mainnet": "npm run build:mainnet -w @squeez/web",
    "build:worker:testnet": "npm run build:worker:testnet -w @squeez/web",
    "build:worker:mainnet": "npm run build:worker:mainnet -w @squeez/web",
    "deploy:web:testnet": "npm run deploy:worker:testnet -w @squeez/web",
    "deploy:web:mainnet": "npm run deploy:worker:mainnet -w @squeez/web",
    "deploy:contracts:testnet": "npm run deploy:testnet -w @squeez/contracts",
    "deploy:contracts:mainnet": "npm run deploy:mainnet -w @squeez/contracts",
    "upgrade:contracts:core:testnet": "npm run upgrade:core:testnet -w @squeez/contracts",
    "upgrade:contracts:curve:testnet": "npm run upgrade:curve:testnet -w @squeez/contracts",
    "configure:contracts:graduation:testnet": "npm run configure:graduation:testnet -w @squeez/contracts",
    "deploy:contracts:graduation-infra:testnet": "npm run deploy:graduation-infra:testnet -w @squeez/contracts",
    "deploy:contracts:hook:testnet": "npm run deploy:hook:testnet -w @squeez/contracts",
    "configure:contracts:hook:testnet": "npm run configure:hook:testnet -w @squeez/contracts",
    "configure:contracts:launch:testnet": "npm run configure:launch:testnet -w @squeez/contracts",
    "deploy:contracts:swap-router:testnet": "npm run deploy:swap-router:testnet -w @squeez/contracts",
    "deploy:contracts:v4-stack:testnet": "npm run deploy:v4-stack:testnet -w @squeez/contracts",
    "build": "npm run build:web:testnet",
    "typecheck": "npm run typecheck -w @squeez/shared -w @squeez/web -w @squeez/backend -w @squeez/indexer -w @squeez/keeper",
    "lint": "npm run lint -w @squeez/web",
    "check:no-fixtures": "node scripts/check-no-fixtures.mjs",
    "check:client-boundary": "node scripts/check-client-boundary.mjs",
    "check:address-book": "node scripts/check-deployment-address-book.mjs",
    "check:addresses:testnet": "node tools/with-env.mjs testnet node scripts/check-loaded-deployment-addresses.mjs",
    "check:addresses:mainnet": "node tools/with-env.mjs mainnet node scripts/check-loaded-deployment-addresses.mjs",
    "deployment:manifest:testnet": "node tools/with-env.mjs testnet node scripts/build-deployment-manifest.mjs testnet",
    "deployment:manifest:mainnet": "node tools/with-env.mjs mainnet node scripts/build-deployment-manifest.mjs mainnet",
    "check:upgrade:testnet": "node tools/with-env.mjs testnet node scripts/check-upgrade-readiness.mjs",
    "check:v4:testnet": "node tools/with-env.mjs testnet node scripts/check-v4-readiness.mjs",
    "check:networks": "node scripts/verify-networks.mjs",
    "check:database:testnet": "node tools/with-env.mjs testnet node scripts/check-database.mjs",
    "check:database:mainnet": "node tools/with-env.mjs mainnet node scripts/check-database.mjs",
    "db:migrate:testnet": "node tools/with-env.mjs testnet node scripts/apply-database-migrations.mjs",
    "db:migrate:mainnet": "node tools/with-env.mjs mainnet node scripts/apply-database-migrations.mjs",
    "db:reset-indexer:testnet": "node tools/with-env.mjs testnet node scripts/reset-testnet-indexer-schema.mjs --confirm-reset-testnet",
    "check:pinata:testnet": "node tools/with-env.mjs testnet node scripts/verify-pinata.mjs",
    "check:pinata:mainnet": "node tools/with-env.mjs mainnet node scripts/verify-pinata.mjs",
    "reconcile:testnet": "node tools/with-env.mjs testnet node scripts/reconcile.mjs",
    "reconcile:mainnet": "node tools/with-env.mjs mainnet node scripts/reconcile.mjs",
    "check:deploy:testnet": "node tools/with-env.mjs testnet node scripts/check-deploy-readiness.mjs",
    "verify:deployment:testnet": "node tools/with-env.mjs testnet node scripts/verify-deployment.mjs",
    "verify:curve-proxy:testnet": "node tools/with-env.mjs testnet node scripts/verify-curve-proxy.mjs",
    "e2e:launch:testnet": "node tools/with-env.mjs testnet node scripts/e2e-launch-testnet.mjs",
    "e2e:trade:testnet": "node tools/with-env.mjs testnet node scripts/e2e-trade-testnet.mjs",
    "e2e:graduate:testnet": "node tools/with-env.mjs testnet node scripts/e2e-graduate-testnet.mjs",
    "e2e:v4-swap:testnet": "node tools/with-env.mjs testnet node scripts/e2e-v4-swap-testnet.mjs",
    "e2e:claim-creator:testnet": "node tools/with-env.mjs testnet node scripts/e2e-claim-creator-testnet.mjs",
    "check": "npm run check:no-fixtures && npm run check:client-boundary && npm run check:address-book && npm run typecheck && npm run lint && npm run build && npm run contracts:fmt-check && npm run contracts:build && npm run contracts:test",
    "contracts:setup": "npm run setup -w @squeez/contracts",
    "contracts:fmt-check": "forge fmt --check --root packages/contracts",
    "contracts:build": "npm run build -w @squeez/contracts",
    "contracts:test": "npm run test -w @squeez/contracts"
  }
}
