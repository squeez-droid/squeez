{
  "name": "squeez",
  "version": "0.1.0",
  "private": true,
  "description": "Squeez: fixed-supply token launchpad on Elysium. Monorepo (npm workspaces).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:web:testnet",
    "dev:web:testnet": "npm run dev -w @squeez/web",
    "dev:web:mainnet": "npm run dev:mainnet -w @squeez/web",
    "dev:api:testnet": "npm run dev -w @squeez/backend",
    "dev:api:mainnet": "npm run dev:mainnet -w @squeez/backend",
    "dev:indexer:testnet": "npm run dev -w @squeez/indexer",
    "dev:indexer:mainnet": "npm run dev:mainnet -w @squeez/indexer",
    "dev:keeper:testnet": "npm run dev -w @squeez/keeper",
    "start:keeper:mainnet": "npm run start:mainnet -w @squeez/keeper",
    "build:web:testnet": "npm run build:testnet -w @squeez/web",
    "build:web:mainnet": "npm run build:mainnet -w @squeez/web",
    "build:worker:testnet": "npm run build:worker:testnet -w @squeez/web",
    "build:worker:mainnet": "npm run build:worker:mainnet -w @squeez/web",
    "deploy:web:testnet": "npm run deploy:worker:testnet -w @squeez/web",
    "deploy:web:mainnet": "npm run deploy:worker:mainnet -w @squeez/web",
    "deploy:contracts:testnet": "npm run deploy:testnet -w @squeez/contracts",
    "deploy:contracts:mainnet": "npm run deploy:mainnet -w @squeez/contracts",
    "build": "npm run build -w @squeez/web",
    "typecheck": "npm run typecheck -w @squeez/shared -w @squeez/web -w @squeez/backend -w @squeez/keeper",
    "lint": "npm run lint -w @squeez/web",
    "check:no-fixtures": "node scripts/check-no-fixtures.mjs",
    "check:client-boundary": "node scripts/check-client-boundary.mjs",
    "check:networks": "node scripts/verify-networks.mjs",
    "check:database:testnet": "node tools/with-env.mjs testnet node scripts/check-database.mjs",
    "check:database:mainnet": "node tools/with-env.mjs mainnet node scripts/check-database.mjs",
    "check": "npm run check:no-fixtures && npm run check:client-boundary && npm run typecheck && npm run lint && npm run build && npm run contracts:fmt-check && npm run contracts:build && npm run contracts:test",
    "contracts:setup": "npm run setup -w @squeez/contracts",
    "contracts:fmt-check": "forge fmt --check --root packages/contracts",
    "contracts:build": "npm run build -w @squeez/contracts",
    "contracts:test": "npm run test -w @squeez/contracts"
  }
}
