FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/indexer/package.json apps/indexer/package.json
COPY apps/keeper/package.json apps/keeper/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci --omit=optional \
    --workspace @squeez/backend \
    --workspace @squeez/shared

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY tools ./tools
COPY apps/backend ./apps/backend
COPY apps/indexer ./apps/indexer
COPY apps/keeper ./apps/keeper
COPY packages/shared ./packages/shared
COPY packages/contracts/deployments ./packages/contracts/deployments
USER node

# Coolify runs this image directly. Keep the network selectable at runtime so
# the same image definition can be used for testnet and mainnet deployments.
CMD ["sh", "-c", "npm run start:${SQUEEZ_NETWORK:-testnet} -w @squeez/backend"]
