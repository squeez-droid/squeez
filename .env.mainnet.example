# Copy to .env.mainnet. One root file configures every mainnet service.
SQUEEZ_NETWORK=mainnet
SQUEEZ_CHAIN=robinhood
SQUEEZ_API_CAPABILITY=read-only
ROBINHOOD_MAINNET_CAPABILITY=read-only
X_OAUTH_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
SQUEEZ_ATTESTER_PRIVATE_KEY=
SQUEEZ_ATTESTER_ADDRESS=
X_MAX_ATTESTED_LAUNCHES_PER_24H=3
NEXT_PUBLIC_SQUEEZ_NETWORK=mainnet
NEXT_PUBLIC_SQUEEZ_CHAIN=robinhood
NEXT_PUBLIC_API_URL=https://api.your-domain.com
PORT=8080
ALLOWED_ORIGINS=https://your-domain.com
ELYSIUM_CHAIN_ID=99901
ELYSIUM_RPC=https://rpc-live.elysp.com
ELYSIUM_EXPLORER=https://elysium.kinetiq.xyz/explorer
# Production requires a dedicated archive-capable provider endpoint. Robinhood recommends Alchemy.
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC=https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_WITH_API_KEY
ROBINHOOD_RPC_FALLBACK=
ROBINHOOD_EXPLORER=https://robinhoodchain.blockscout.com
ROBINHOOD_DATABASE_SCHEMA=robinhood_mainnet
INDEXER_MAX_REQUESTS_PER_SECOND=2
INDEXER_LOG_BLOCK_RANGE=10
# Never inherit production wallet authority implicitly.
ROBINHOOD_REUSE_ELYSIUM_WALLETS=false
ROBINHOOD_DEPLOYER_PRIVATE_KEY=
ROBINHOOD_UPGRADE_ADMIN_PRIVATE_KEY=
ROBINHOOD_ADMIN_MULTISIG=
ROBINHOOD_GOVERNANCE_SAFE_ADDRESS=
ROBINHOOD_NEXT_ADMIN_MULTISIG=
ROBINHOOD_GOVERNANCE_TIMELOCK_DELAY_SECONDS=300
ROBINHOOD_GOVERNANCE_TIMELOCK_ADDRESS=
ROBINHOOD_SAFE_SIGNER_1=
ROBINHOOD_SAFE_SIGNER_2=
ROBINHOOD_SAFE_SIGNER_3=
ROBINHOOD_SAFE_THRESHOLD=2
ROBINHOOD_TREASURY=
# Official Uniswap deployment addresses still require bytecode/interface verification before use.
ROBINHOOD_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
ROBINHOOD_POSITION_MANAGER=0x58daec3116aae6d93017baaea7749052e8a04fa7
