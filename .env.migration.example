# One-time Supabase migration inputs. Never put real credentials in this example file.
# SOURCE_DATABASE_URL is optional; when empty, the tooling reads DATABASE_URL from .env.testnet.
SOURCE_DATABASE_URL=
TARGET_DATABASE_URL=
MIGRATION_INDEXER_MAX_REQUESTS_PER_SECOND=1
MIGRATION_INDEXER_LOG_BLOCK_RANGE=10
